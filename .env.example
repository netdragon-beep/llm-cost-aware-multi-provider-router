# Core
LITELLM_MASTER_KEY=replace-with-strong-random-value
OPEN_WEBUI_SECRET_KEY=replace-with-strong-random-value
LITELLM_PORT=4100
OPEN_WEBUI_PORT=8090
ADMIN_PANEL_PORT=8091

# Optional hardening
USER_AGENT=RelayDeckLocal/1.0
# CORS_ALLOW_ORIGIN=http://127.0.0.1:8090;http://127.0.0.1:8091

# Open WebUI / RAG
OFFLINE_MODE=true
RAG_EMBEDDING_ENGINE=openai
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_MODEL_AUTO_UPDATE=false
ENABLE_RAG_HYBRID_SEARCH=false
BYPASS_EMBEDDING_AND_RETRIEVAL=true

# Provider keys
OPENAI_API_KEY=
PACKYAPI_KEY_1=
LUSEN_API_KEY=
AUTOCODEX_API_KEY=
LINGSUAN_API_KEY=
OWL_API_KEY=
CLAUDE_API_KEY=
IMAGE2_API_KEY=
AUTOCODEX_IMAGE_API_KEY=
