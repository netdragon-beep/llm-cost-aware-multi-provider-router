{
  "version": 1,
  "id": "adapter-template",
  "display_name": "Example supplier quota",
  "supported_hosts": ["provider.example"],
  "capabilities": ["fetch_quota", "fetch_pricing", "browser_sso", "refresh_session"],
  "browser_sso": {
    "portal_hosts": ["provider.example"],
    "login_path": "/dashboard",
    "auth_me_path": "/api/v1/auth/me",
    "cookie_domains": ["provider.example"],
    "google_rejection_check": true
  },
  "credential_permissions": ["auth_token", "session_cookie", "refresh_token", "api_key_value"]
}
